# Point beeCode at any OpenAI-compatible endpoint without editing config.json.
#
#   copy .env.llm.example .env.llm     (then fill in your values)
#
# .env.llm is git-ignored on purpose: the key must never be committed, and it is never
# copied into ~/.beecode/config.json either — the service republishes it to the
# BEECODE_LLM_API_KEY environment variable and the saved preset only references that name.
#
# The file is read from the working directory of the service, then from the user's home
# directory, so a single copy in ~/.beecode/.env.llm applies to every workspace.
API_KEY=sk-replace-me
URL=https://api.example.dev/v1
MODEL=my-model
